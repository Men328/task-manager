# API base URLs used by the frontend.
# In dev these point at the Vite proxy prefixes; the proxy strips the prefix
# and forwards to the identity (8081) / task (8082) / calendar (8083) services.
#
# Keep these RELATIVE in Docker / Cloudflare Tunnel builds: the browser then
# calls the frontend origin itself and nginx forwards internally, so the tunnel
# only ever exposes one port (xem deployments/docker/README.md).
VITE_IDENTITY_API_URL=/api/identity
VITE_TASK_API_URL=/api/task
VITE_CALENDAR_API_URL=/api/calendar
