// =============================================================================
// Personal Task Manager - DBML for https://dbdiagram.io
// -----------------------------------------------------------------------------
// QUY ƯỚC ĐẶT TÊN
//   - service (schema) : chữ thường          -> identity, task, mail_provider
//   - table            : CHỮ HOA + hậu tố S  -> PROFILES, TASKS, TASK_STATUSES
//   - column           : snake_case thường   -> profile_id, created_at
//   - enum             : snake_case thường   -> task_priority, status_category
//   - Tham chiếu bảng  : <service>.<TABLES>
//
// PHẠM VI
//   identity      service : PROFILES (hồ sơ identity) + AUTH_PROVIDERS (đăng nhập)
//   task          service : TASKS (cha/con), TASK_STATUSES (status của profile, 1-n),
//                           STATUS_TRANSITIONS (lifecycle rule), TASK_STATUS_LOGS
//   calendar      service : SCHEDULES (lịch cá nhân của profile)
//   mail_provider service : SESSIONS (kết nối Gmail: refresh token của user),
//                           NOTI_INDEXES (checkpoint historyId + hạn watch Gmail)
//
// NGUYÊN TẮC
//   - Profile là gốc sở hữu: task, status, transition, task log đều trỏ về profile_id.
//   - Status/transition thuộc sở hữu của profile_id.
//   - Rule chuyển trạng thái = ALLOWLIST: có row => được phép, không có => cấm.
//   - Ref khai báo theo TỪNG CỘT (single-column): mỗi Ref chỉ nối 1 cột -> 1 cột,
//     không dùng composite FK. Việc đảm bảo các bảng con cùng profile
//     được enforce ở tầng service (hoặc trigger).
//   - LƯU Ý: tên bảng viết HOA nên PostgreSQL luôn phải quote:
//     SELECT ... FROM "task"."TASKS". ORM cần mapping tên bảng.
// =============================================================================

Project task_manager {
  database_type: 'PostgreSQL'
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------
Enum task_priority {
  low
  medium
  high
  urgent
}

// Phân loại ngữ nghĩa của status, dùng cho logic app (auto set completed_at,
// coi là "đang mở", thống kê...). Không dùng để chặn transition.
Enum status_category {
  todo
  in_progress
  done
  cancelled
}

// =============================================================================
// SERVICE: identity
// =============================================================================
Table identity.PROFILES {
  id            uuid         [pk, default: `gen_random_uuid()`]
  email         varchar(255) [not null]
  password_hash varchar(255) [note: 'NULL nếu profile chỉ đăng nhập qua provider ngoài']
  display_name  varchar(100) [not null]
  avatar_url    text
  timezone      varchar(64)  [not null, default: 'Asia/Ho_Chi_Minh']
  locale        varchar(10)  [not null, default: 'vi']
  is_active     boolean      [not null, default: true]
  last_login_at timestamptz
  created_at    timestamptz  [not null, default: `now()`]
  updated_at    timestamptz  [not null, default: `now()`]
  deleted_at    timestamptz  [note: 'Soft delete']

  Note: '''
  Bảng hồ sơ identity gốc (trước đây là users -> IDENTITYS).
  Soft delete để không mất task/history.
  '''

  indexes {
    email [unique, name: 'uq_profiles_email']
    (is_active, deleted_at)
  }
}

// Tùy chọn: tách các phương thức đăng nhập ra khỏi PROFILES.
Table identity.AUTH_PROVIDERS {
  id               uuid         [pk, default: `gen_random_uuid()`]
  profile_id       uuid         [not null]
  provider         varchar(32)  [not null, note: 'email | google | github | apple']
  provider_user_id varchar(255) [not null, note: 'sub/uid trả về từ provider']
  created_at       timestamptz  [not null, default: `now()`]

  indexes {
    (profile_id, provider)       [unique, name: 'uq_auth_providers_profile_provider']
    (provider, provider_user_id) [unique, name: 'uq_auth_providers_provider_uid']
  }
}

// =============================================================================
// SERVICE: task
// =============================================================================

// --- 1. Status thuộc quyền quản lý của profile (1-n) ---
Table task.TASK_STATUSES {
  id          uuid            [pk, default: `gen_random_uuid()`]
  profile_id  uuid            [not null]
  name        varchar(50)     [not null, note: 'Tên hiển thị: Todo, Đang làm, Done...']
  slug        varchar(50)     [not null, note: 'Key ổn định cho API/logic, unique theo profile']
  description text
  color       varchar(9)      [note: '#RRGGBB hoặc #RRGGBBAA']
  category    status_category [not null, default: 'todo']
  is_default  boolean         [not null, default: false, note: 'Status khởi tạo cho task mới']
  is_terminal boolean         [not null, default: false, note: 'Kết thúc flow; thường không có transition đi ra']
  position    integer         [not null, default: 0, note: 'Thứ tự hiển thị trên board']
  is_archived boolean         [not null, default: false, note: 'Ẩn khỏi UI nhưng giữ nguyên task cũ']
  created_at  timestamptz     [not null, default: `now()`]
  updated_at  timestamptz     [not null, default: `now()`]

  Note: '''
  Ràng buộc cần enforce thêm ở tầng DB (PostgreSQL partial unique index):
    CREATE UNIQUE INDEX uq_task_statuses_one_default
      ON task.TASK_STATUSES (profile_id) WHERE is_default AND NOT is_archived;
  Không hard-delete status đang được dùng -> dùng is_archived.
  '''

  indexes {
    (id, profile_id)   [unique, name: 'uq_task_statuses_id_profile']
    (profile_id, slug) [unique, name: 'uq_task_statuses_profile_slug']
    (profile_id, position)
  }
}

// --- 2. Lifecycle: rule chuyển trạng thái ---
//     Ví dụ: A -> B OK, A -> C OK, A -> D KHÔNG OK
//     => có row (A,B), (A,C); KHÔNG có row (A,D) là đủ để cấm.
Table task.STATUS_TRANSITIONS {
  id             uuid        [pk, default: `gen_random_uuid()`]
  profile_id     uuid        [not null]
  from_status_id uuid        [not null]
  to_status_id   uuid        [not null]
  is_active      boolean     [not null, default: true, note: 'Tắt rule mà không cần xoá']
  requires_note  boolean     [not null, default: false, note: 'Bắt buộc nhập lý do khi chuyển']
  guard          jsonb       [note: 'Điều kiện mở rộng: chỉ admin, phải có due_date... (tuỳ chọn)']
  description    text
  created_at     timestamptz [not null, default: `now()`]
  updated_at     timestamptz [not null, default: `now()`]

  Note: '''
  - UNIQUE (from_status_id, to_status_id): không khai báo trùng rule.
  - CHECK (from_status_id <> to_status_id): mặc định không cho A -> A.
  - Nếu muốn cho phép A -> A: bỏ check và thêm cờ allow_self_transition.
  - is_terminal = true thường đi kèm việc không tạo transition đi ra.
  '''

  indexes {
    (from_status_id, to_status_id) [unique, name: 'uq_status_transitions_from_to']
    (profile_id, from_status_id)
  }
}

// --- 3. Task (cha - con) ---
Table task.TASKS {
  id             uuid          [pk, default: `gen_random_uuid()`]
  profile_id     uuid          [not null]
  parent_task_id uuid          [note: 'NULL = task gốc (root)']
  status_id      uuid          [not null]
  title          varchar(500)  [not null]
  description    text
  priority       task_priority [not null, default: 'medium']
  position       integer       [not null, default: 0, note: 'Thứ tự trong cùng parent']
  start_at       timestamptz
  due_at         timestamptz
  completed_at   timestamptz   [note: 'Set khi status chuyển sang category = done']
  is_archived    boolean       [not null, default: false]
  created_at     timestamptz   [not null, default: `now()`]
  updated_at     timestamptz   [not null, default: `now()`]
  deleted_at     timestamptz   [note: 'Soft delete; xoá cha không tự xoá con']

  Note: '''
  - Ref single-column: TASKS.status_id -> task.TASK_STATUSES.id (task cha - con:
    TASKS.parent_task_id -> TASKS.id). Lưu ý ON DELETE SET NULL cho parent_task_id
    cần cú pháp Postgres 15+: ON DELETE SET NULL (parent_task_id).
  - Chống vòng lặp (A là con của B, B là con của A) không thể khai báo thuần
    declarative -> enforce bằng trigger hoặc ở tầng service khi reparent.
  - Giới hạn độ sâu (ví dụ max 5 tầng) cũng nên enforce ở service/trigger.
  - Truy vấn cây dùng recursive CTE trên (profile_id, parent_task_id);
    nếu cây sâu/nặng có thể thêm cột materialized path sau.
  '''

  indexes {
    (id, profile_id)                          [unique, name: 'uq_tasks_id_profile']
    (profile_id, status_id)
    (profile_id, parent_task_id, position)
    (profile_id, due_at)
    (profile_id, is_archived, deleted_at)
  }
}

// --- 4. Audit: lịch sử chuyển trạng thái ---
Table task.TASK_STATUS_LOGS {
  id             bigserial   [pk]
  task_id        uuid        [not null]
  profile_id     uuid        [not null]
  from_status_id uuid        [note: 'NULL = lần gán status đầu tiên']
  to_status_id   uuid        [not null]
  note           text
  changed_at     timestamptz [not null, default: `now()`]

  Note: '''
  Append-only. Dùng để: đo cycle time, hoàn tác, kiểm toán rule.
  Ghi log trong cùng transaction với update task.TASKS.status_id.
  '''

  indexes {
    (task_id, changed_at)
    (profile_id, to_status_id)
  }
}

// =============================================================================
// SERVICE: mail_provider
// =============================================================================
// Service nhận notice Gmail qua Pub/Sub rồi tạo task. Trước đây toàn bộ trạng
// thái nằm trong RAM của container mail-provider-grpc (model.Subscription +
// TokenManager) nên restart là mất sạch: user phải đăng nhập lại, và mọi notice
// đến sau đó bị bỏ qua ("hộp thư chưa đăng ký").
//
// Hai bảng dưới đây là nơi lưu trạng thái đó (repository Postgres, dùng khi
// DATABASE_URL được set; không set thì service quay về store in-memory).
// Tách làm 2 vì tần suất ghi và độ nhạy cảm khác nhau:
//   SESSIONS     : ghi rất ít (lúc login, lúc Google trả refresh token mới, lúc
//                  ngắt kết nối) nhưng chứa CREDENTIAL -> cần mã hoá at-rest.
//   NOTI_INDEXES : ghi liên tục (mỗi notice tiến checkpoint một lần) -> tách ra
//                  để không phải rewrite row đang chứa refresh_token.
// =============================================================================

// --- 1. Kết nối OAuth của user: giữ refresh token để gọi Gmail API ---
Table mail_provider.SESSIONS {
  id                      uuid         [pk, default: `gen_random_uuid()`]
  profile_id              uuid         [not null, note: 'Chủ hộp thư']
  provider                varchar(32)  [not null, default: 'google', note: 'google | ... (hiện chỉ google)']
  email                   varchar(255) [not null, note: 'Hộp thư được watch; khoá tra ngược từ notice Pub/Sub (payload chỉ có emailAddress)']
  refresh_token           text         [note: 'Mã hoá at-rest; KHÔNG log, KHÔNG trả ra ngoài tầng repository. NULL = Google không trả refresh token (watch chỉ sống ~1h)']
  access_token            text         [note: 'Cache token ngắn hạn (~1h). NULL = sẽ refresh khi cần']
  access_token_expires_at timestamptz  [note: 'Hạn access_token; NULL = coi như đã hết hạn']
  revoked_at              timestamptz  [note: 'Set khi user ngắt kết nối hoặc Google thu hồi; giữ row để audit']
  created_at              timestamptz  [not null, default: `now()`]
  updated_at              timestamptz  [not null, default: `now()`]

  Note: '''
  "SESSIONS" ở đây là PHIÊN UỶ QUYỀN GOOGLE của user (OAuth connection), KHÔNG
  phải session đăng nhập của app (session JWT do identity phát, frontend giữ ở
  localStorage). Nếu muốn tên rõ nghĩa hơn: MAIL_ACCOUNTS hoặc GMAIL_SESSIONS.

  Thay thế cho phần token cache trong model.Subscription (đang ở RAM):
    AccessToken, RefreshToken, AccessTokenExpiresAt
  và thay cho index byEmail trong InMemorySubscriptionRepository (dùng để tra
  profile_id khi notice chỉ mang emailAddress).

  Vòng đời:
    - INSERT/UPDATE khi identity gọi Subscribe sau lúc user login với scope
      gmail.readonly + access_type=offline.
    - UPDATE access_token khi TokenManager refresh.
    - UPDATE revoked_at (không xoá row) khi Unsubscribe / Google trả 401.
    - Xoá cứng chỉ khi xoá profile (cascade).

  Ràng buộc cần enforce thêm ở tầng DB (PostgreSQL):
    CREATE UNIQUE INDEX uq_mail_provider_sessions_email
      ON mail_provider.SESSIONS (lower(email)) WHERE revoked_at IS NULL;
    CHECK (btrim(email) <> '');
    CHECK (btrim(provider) <> '');
  Trigger updated_at dùng lại identity.fn_set_updated_at (đã có ở migration 000001).
  '''

  indexes {
    (profile_id, provider) [unique, name: 'uq_mail_provider_sessions_profile_provider']
    email                  [unique, name: 'uq_mail_provider_sessions_email']
  }
}

// --- 2. Checkpoint: đã xử lý tới historyId nào + trạng thái watch Gmail ---
Table mail_provider.NOTI_INDEXES {
  id               uuid        [pk, default: `gen_random_uuid()`]
  profile_id       uuid        [not null, note: '1-1 với hộp thư đang watch (giả định 1 hộp thư / profile)']
  history_id       varchar(32) [note: 'Cursor của Gmail: đã xử lý tới historyId này; dùng làm startHistoryId. NULL = chưa biết checkpoint']
  watch_expires_at timestamptz [note: 'Hạn users.watch (tối đa 7 ngày). NULL = chưa có watch']
  last_notice_at   timestamptz [note: 'Lần cuối watch được xác nhận còn sống (có notice hoặc gia hạn); dùng phát hiện watch chết im lặng']
  created_at       timestamptz [not null, default: `now()`]
  updated_at       timestamptz [not null, default: `now()`]

  Note: '''
  Thay thế cho 2 field còn lại của model.Subscription (đang ở RAM):
    HistoryID, WatchExpiresAt.

  Vì sao history_id là varchar chứ không phải bigint:
    Gmail trả historyId dạng uint64 (tới 20 chữ số) và tài liệu coi nó là giá
    trị OPAQUE — không cộng/trừ, chỉ truyền lại làm startHistoryId. bigint có
    dấu (max ~9.2e18) không đủ chắc; varchar(32) khớp với model.HistoryID
    (string) và với kiểm tra isDigits() ở model/notice.go.

  Checkpoint chỉ được TIẾN sau khi đã xử lý xong message:
    - crash giữa chừng -> lần sau đọc lại từ checkpoint cũ -> có thể tạo task
      TRÙNG (hiện chưa dedupe theo messageId) nhưng KHÔNG mất mail.
    - Tuyệt đối không UPDATE history_id trước khi gọi task service.
    - historyId quá cũ -> Gmail trả 404: đặt lại checkpoint theo users.getProfile
      và bỏ qua khoảng đã mất (log cảnh báo).

  watch_expires_at và last_notice_at tồn tại chỉ để VẬN HÀNH, không phục vụ
  nghiệp vụ:
    - renewLoop cần watch_expires_at để biết watch nào sắp hết hạn mà gia hạn;
      ở bản in-memory, mất store là mù hoàn toàn nên không gia hạn được gì.
    - last_notice_at để phát hiện "topic im lặng bất thường" (watch hết hạn,
      thiếu roles/pubsub.publisher, sub bị xoá) — trạng thái này hiện không
      phân biệt được với "hộp thư không có mail mới".

  Nếu sau này 1 profile watch NHIỀU hộp thư: bỏ unique(profile_id) và chuyển
  khoá sang (profile_id, email) — khi đó nên thêm cột email vào bảng này.

  Ràng buộc cần enforce thêm ở tầng DB (PostgreSQL):
    CONSTRAINT uq_mail_provider_noti_indexes_profile UNIQUE (profile_id);
    CONSTRAINT ck_mail_provider_noti_indexes_history_id_digits
      CHECK (history_id IS NULL OR history_id ~ '^[0-9]+$');
  '''

  indexes {
    profile_id       [unique, name: 'uq_mail_provider_noti_indexes_profile']
    watch_expires_at
  }
}

// =============================================================================
// SERVICE: calendar
// =============================================================================
// Lịch (event) cá nhân của từng profile. CRUD cơ bản: chưa có lặp/định kỳ,
// người tham gia, nhắc hẹn hay đồng bộ Google Calendar.
// =============================================================================

Table calendar.schedules {
  id          uuid         [pk, default: `gen_random_uuid()`]
  profile_id  uuid         [not null]
  title       varchar(500) [not null]
  description text
  location    varchar(255)
  start_at    timestamptz  [not null, note: 'Thời điểm bắt đầu']
  end_at      timestamptz  [note: 'NULL = mốc thời gian không có thời lượng']
  all_day     boolean      [not null, default: false, note: 'FullCalendar allDay: lịch cả ngày']
  color       varchar(9)   [note: '#RRGGBB hoặc #RRGGBBAA; NULL = màu mặc định của UI']
  created_at  timestamptz  [not null, default: `now()`]
  updated_at  timestamptz  [not null, default: `now()`]

  Note: '''
  Ràng buộc cần enforce thêm ở tầng DB (PostgreSQL):
    CONSTRAINT ck_calendar_schedules_title_not_blank CHECK (btrim(title) <> '');
    CONSTRAINT ck_calendar_schedules_time_range
      CHECK (end_at IS NULL OR end_at >= start_at);
    CONSTRAINT ck_calendar_schedules_color_format
      CHECK (color IS NULL OR color ~* '^#[0-9a-f]{6}([0-9a-f]{2})?$');

  Truy vấn chính của UI: lịch của 1 profile giao với khoảng [from, to)
  -> index (profile_id, start_at).
  '''

  indexes {
    (profile_id, start_at)
  }
}

// =============================================================================
// SERVICE: event
// =============================================================================
// Sự kiện cá nhân của từng profile. Khác calendar.schedules ở `status` (vòng đời
// planned/confirmed/cancelled) và `source` (id email nguồn khi mail worker tạo).
// CRUD cơ bản: chưa có người tham gia, lặp/định kỳ, nhắc hẹn.
// =============================================================================

Table event.events {
  id          uuid         [pk, default: `gen_random_uuid()`]
  profile_id  uuid         [not null]
  title       varchar(500) [not null]
  description text
  location    varchar(255)
  start_at    timestamptz  [not null, note: 'Thời điểm bắt đầu']
  end_at      timestamptz  [note: 'NULL = mốc thời gian không có thời lượng']
  all_day     boolean      [not null, default: false]
  color       varchar(9)   [note: '#RRGGBB hoặc #RRGGBBAA; NULL = màu mặc định của UI']
  status      varchar(20)  [not null, default: 'PLANNED', note: 'PLANNED | CONFIRMED | CANCELLED']
  source      varchar(255) [note: 'Id email nguồn; NULL = người dùng tạo trên UI']
  created_at  timestamptz  [not null, default: `now()`]
  updated_at  timestamptz  [not null, default: `now()`]

  Note: '''
  Ràng buộc cần enforce thêm ở tầng DB (PostgreSQL):
    CONSTRAINT ck_event_events_title_not_blank CHECK (btrim(title) <> '');
    CONSTRAINT ck_event_events_time_range CHECK (end_at IS NULL OR end_at >= start_at);
    CONSTRAINT ck_event_events_color_format
      CHECK (color IS NULL OR color ~* '^#[0-9a-f]{6}([0-9a-f]{2})?$');
    CONSTRAINT ck_event_events_status
      CHECK (status IN ('PLANNED', 'CONFIRMED', 'CANCELLED'));

  Truy vấn chính: sự kiện của 1 profile trong khoảng [from, to) + lọc status
  -> index (profile_id, start_at).
  '''

  indexes {
    (profile_id, start_at)
  }
}

// =============================================================================
// SERVICE: backlog
// =============================================================================
// Mail worker đẩy mọi email KHÔNG phân loại được thành task/schedule/event vào
// đây (category = 'other'), kèm lý do và object key của email gốc trên object storage.
// Người dùng cũng tạo/sửa mục backlog trực tiếp trên UI.
// =============================================================================

Table backlog.backlogs {
  id          uuid         [pk, default: `gen_random_uuid()`]
  profile_id  uuid         [not null]
  title       varchar(500) [not null]
  description text
  sender      varchar(320) [note: 'Header From của email nguồn']
  source      varchar(255) [note: 'Gmail message id; dùng để truy vết/chống trùng']
  category    varchar(20)  [not null, default: 'other', note: 'task | schedule | event | other']
  reason      text         [note: 'Lý do bị đẩy vào backlog']
  object_key  varchar(512) [note: 'Object key trên object storage S3 (email gốc JSON)']
  status      varchar(20)  [not null, default: 'NEW', note: 'NEW | TRIAGED | ARCHIVED']
  created_at  timestamptz  [not null, default: `now()`]
  updated_at  timestamptz  [not null, default: `now()`]

  Note: '''
  Ràng buộc cần enforce thêm ở tầng DB (PostgreSQL):
    CONSTRAINT ck_backlog_backlogs_title_not_blank CHECK (btrim(title) <> '');
    CONSTRAINT ck_backlog_backlogs_status
      CHECK (status IN ('NEW', 'TRIAGED', 'ARCHIVED'));

  Truy vấn chính: backlog mới nhất của 1 profile -> index (profile_id, created_at DESC).
  Truy vết theo message id nguồn -> partial index (source) WHERE source IS NOT NULL.
  '''

  indexes {
    (profile_id, created_at)
    source [note: 'partial index WHERE source IS NOT NULL']
  }
}

// =============================================================================
// NOTIFICATION SERVICE
// =============================================================================
// Thông báo của user. mail-provider tạo notice sau khi phân loại email thành
// công; notification service lưu rồi push qua soketi vào kênh private của user
// (`private-noti-internal-<profile_id>`). UI hiển thị số chưa đọc và đánh dấu
// đã đọc khi mở đối tượng (hoặc đánh dấu tất cả bằng id = '*').

Table notification.notices {
  id          uuid         [pk, default: `gen_random_uuid()`]
  profile_id  uuid         [not null]
  type        varchar(64)  [not null, note: 'TASK_CREATED | SCHEDULE_CREATED | EVENT_CREATED | BACKLOG_CREATED']
  title       varchar(500) [not null]
  body        text
  target_type varchar(32)  [not null, note: 'task | schedule | event | backlog']
  target_id   uuid         [not null, note: 'Id đối tượng nguồn để UI mở đúng trang']
  source      varchar(255) [note: 'Gmail message id nguồn (nếu có)']
  is_read     boolean      [not null, default: false]
  read_at     timestamptz  [note: 'Thời điểm đánh dấu đã đọc; NULL khi chưa đọc']
  created_at  timestamptz  [not null, default: `now()`]
  updated_at  timestamptz  [not null, default: `now()`]

  Note: '''
  Ràng buộc cần enforce thêm ở tầng DB (PostgreSQL):
    CONSTRAINT ck_notification_notices_title_not_blank CHECK (btrim(title) <> '');
    CONSTRAINT ck_notification_notices_target_type
      CHECK (target_type IN ('task', 'schedule', 'event', 'backlog'));
    CONSTRAINT ck_notification_notices_read_at CHECK (is_read OR read_at IS NULL);

  Truy vấn chính: đếm/list notice CHƯA đọc của 1 profile
    -> partial index (profile_id, created_at DESC) WHERE is_read = false.
  Danh sách notice mới nhất (mọi trạng thái) -> index (profile_id, created_at DESC).
  Mọi thao tác đọc/đánh dấu đều scope theo profile_id để chỉ tác động notice của
  chính user đang sở hữu.
  '''

  indexes {
    (profile_id, created_at) [note: 'partial index WHERE is_read = false cho truy vấn chưa đọc']
    (target_type, target_id)
  }
}

// =============================================================================
// RELATIONSHIPS
// =============================================================================

// --- identity service ---
Ref: identity.AUTH_PROVIDERS.profile_id > identity.PROFILES.id [delete: cascade]

// --- owner: mọi dữ liệu task đều thuộc 1 profile ---
Ref: task.TASK_STATUSES.profile_id > identity.PROFILES.id [delete: cascade]
Ref: task.STATUS_TRANSITIONS.profile_id > identity.PROFILES.id [delete: cascade]
Ref: task.TASKS.profile_id > identity.PROFILES.id [delete: cascade]

// --- lifecycle rules ---
Ref: task.STATUS_TRANSITIONS.from_status_id > task.TASK_STATUSES.id [delete: cascade]
Ref: task.STATUS_TRANSITIONS.to_status_id   > task.TASK_STATUSES.id [delete: cascade]

// --- task ---
Ref: task.TASKS.status_id      > task.TASK_STATUSES.id [delete: restrict]
Ref: task.TASKS.parent_task_id > task.TASKS.id [delete: no action]

// --- audit ---
Ref: task.TASK_STATUS_LOGS.task_id        > task.TASKS.id [delete: cascade]
Ref: task.TASK_STATUS_LOGS.from_status_id > task.TASK_STATUSES.id [delete: no action]
Ref: task.TASK_STATUS_LOGS.to_status_id   > task.TASK_STATUSES.id [delete: no action]

// --- mail_provider: kết nối Gmail của user ---
// Cả 2 bảng đều thuộc 1 profile. Ref về PROFILES cho nhất quán với các service
// khác; nếu muốn DB đảm bảo "không có checkpoint mồ côi" thì đổi
// NOTI_INDEXES.profile_id trỏ về mail_provider.SESSIONS.profile_id (unique).
Ref: mail_provider.SESSIONS.profile_id     > identity.PROFILES.id [delete: cascade]
Ref: mail_provider.NOTI_INDEXES.profile_id > identity.PROFILES.id [delete: cascade]

// --- calendar: lịch thuộc 1 profile ---
Ref: calendar.schedules.profile_id > identity.PROFILES.id [delete: cascade]

// --- event: sự kiện thuộc 1 profile ---
Ref: event.events.profile_id > identity.PROFILES.id [delete: cascade]

// --- backlog: mục backlog thuộc 1 profile ---
Ref: backlog.backlogs.profile_id > identity.PROFILES.id [delete: cascade]

// --- notification: mỗi notice thuộc 1 profile ---
Ref: notification.notices.profile_id > identity.PROFILES.id [delete: cascade]

// =============================================================================
// TABLE GROUPS (chỉ để hiển thị đẹp trên dbdiagram, không ảnh hưởng DDL)
// =============================================================================
TableGroup identity_service {
  identity.PROFILES
  identity.AUTH_PROVIDERS
}

TableGroup task_service {
  task.TASK_STATUSES
  task.STATUS_TRANSITIONS
  task.TASKS
  task.TASK_STATUS_LOGS
}

TableGroup calendar_service {
  calendar.schedules
}

TableGroup event_service {
  event.events
}

TableGroup backlog_service {
  backlog.backlogs
}

TableGroup mail_provider_service {
  mail_provider.SESSIONS
  mail_provider.NOTI_INDEXES
}

TableGroup notification_service {
  notification.notices
}

// =============================================================================
// GHI CHÚ MỞ RỘNG (chưa đưa vào scope hiện tại)
// -----------------------------------------------------------------------------
// - lifecycles: nếu sau này 1 profile có NHIỀU workflow (Personal / Work / Study),
//   thêm bảng task.LIFECYCLES(profile_id, name, is_default) và cho TASK_STATUSES +
//   STATUS_TRANSITIONS trỏ về lifecycle_id thay vì trực tiếp profile_id.
// - tags / task_tags: gắn nhãn chéo cây task.
// - task_attachments, task_comments.
// - recurring_tasks: rule lặp (RRULE) sinh task định kỳ.
// - TASK_STATUS_LOGS nên bổ sung actor_id nếu sau này có chia sẻ task.
// - mail_provider: nếu cần audit/retry notice thì thêm
//   mail_provider.NOTICES(id, message_id unique để dedupe, payload jsonb,
//   received_at, processed_at) — hiện chưa có nên việc chống trùng hoàn toàn
//   dựa vào checkpoint historyId, không dedupe theo messageId.
// - mail_provider: refresh_token nên được mã hoá at-rest (key trong env/KMS,
//   hoặc secret manager) thay vì để text thuần; cân nhắc cả việc rotate.
// =============================================================================
