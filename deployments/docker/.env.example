# Copy sang `.env` trong cùng thư mục này rồi điền giá trị thật:
#   cp deployments/docker/.env.example deployments/docker/.env
#
# docker compose tự đọc file `.env` cạnh docker-compose.yml.

# --- Google OAuth ---------------------------------------------------------
# Tạo OAuth 2.0 Client ID (loại "Web application") tại
# https://console.cloud.google.com/apis/credentials
#
# Authorized redirect URI phải trùng khít GOOGLE_REDIRECT_URL bên dưới.
# Dùng origin của frontend (không phải :8081) để nginx/vite proxy tiếp sang
# gateway identity — nhờ vậy state OAuth vẫn cùng origin với SPA.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GOOGLE_REDIRECT_URL và FRONTEND_BASE_URL được suy ra từ PUBLIC_BASE_URL ở cuối
# file. Chỉ bỏ comment 2 dòng dưới nếu muốn override riêng.
# GOOGLE_REDIRECT_URL=http://localhost:3000/api/identity/v1/auth/google/callback
# FRONTEND_BASE_URL=http://localhost:3000

# --- Session --------------------------------------------------------------
# Khoá ký JWT (HS256) và state OAuth. Bắt buộc, tối thiểu 16 ký tự.
# Sinh khoá: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL=720h
# Bật khi chạy sau HTTPS (cookie/redirect an toàn hơn).
COOKIE_SECURE=false

# --- Cloudflare Tunnel ----------------------------------------------------
# Tunnel token: Cloudflare Zero Trust > Networks > Tunnels > chọn tunnel >
# "Install connector" (Docker) -> lấy chuỗi sau `--token`.
#
# Public hostname của tunnel phải trỏ tới service `http://frontend:80`
# (không phải :8081/:8082/:8083) — đúng MỘT origin duy nhất, vì nginx của
# frontend tự forward /api/* sang các service Go.
#
# Bật connector. Có 2 cách:
#   - make up-tunnel                              (chỉ lần chạy đó)
#   - bỏ comment `COMPOSE_PROFILES=tunnel` dưới  (mọi lệnh compose/`make up`)
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_VERSION=latest

# Port host bind cho entrypoint. Chỉ bind 127.0.0.1 nên không lộ trực tiếp.
FRONTEND_PORT=3000

# Cho cloudflared chạy ngay trong `docker compose up` / `make up` mặc định.
# Đây là biến của chính Compose (không phải của cloudflared).
# COMPOSE_PROFILES=tunnel

# --- Public origin --------------------------------------------------------
# Origin công khai DUY NHẤT của hệ thống. Compose suy ra GOOGLE_REDIRECT_URL và
# FRONTEND_BASE_URL từ biến này.
#   - Chạy local:      http://localhost:3000
#   - Sau Cloudflare:  https://<hostname>
#     (nhớ thêm redirect URI vào Google Cloud Console:
#      <PUBLIC_BASE_URL>/api/identity/v1/auth/google/callback)
# Đổi sang https thì đặt luôn COOKIE_SECURE=true.
PUBLIC_BASE_URL=http://localhost:3000

