# Copy sang `.env` trong cùng thư mục này rồi điền giá trị thật:
#   cp deployments/docker/.env.example deployments/docker/.env
#
# docker compose tự đọc file `.env` cạnh docker-compose.yml.

# --- Google OAuth ---------------------------------------------------------
# Tạo OAuth 2.0 Client ID (loại "Web application") tại
# https://console.cloud.google.com/apis/credentials
#
# Authorized redirect URI phải trùng khít GOOGLE_REDIRECT_URL bên dưới.
# Dùng origin của frontend (không phải :8081) để nginx/vite proxy tiếp sang
# gateway identity — nhờ vậy state OAuth vẫn cùng origin với SPA.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GOOGLE_REDIRECT_URL và FRONTEND_BASE_URL được suy ra từ PUBLIC_BASE_URL ở cuối
# file. Chỉ bỏ comment 2 dòng dưới nếu muốn override riêng.
# GOOGLE_REDIRECT_URL=http://localhost:3000/api/identity/v1/auth/google/callback
# FRONTEND_BASE_URL=http://localhost:3000

# --- Session --------------------------------------------------------------
# Khoá ký JWT (HS256) và state OAuth. Bắt buộc, tối thiểu 16 ký tự.
# Sinh khoá: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL=720h
# Bật khi chạy sau HTTPS (cookie/redirect an toàn hơn).
COOKIE_SECURE=false

# --- Gmail (mail-provider) ------------------------------------------------
# Bật tính năng "tự động tạo task từ email". User chỉ nhận watch khi tích ô
# "Cho phép đọc Gmail" ở màn đăng nhập.
#
# Topic Pub/Sub phải nằm CÙNG project với OAuth client ở trên, và đã cấp quyền
# publish cho gmail-api-push@system.gserviceaccount.com.
# Ví dụ: projects/my-project/topics/gmail-notifications
MAIL_PUBSUB_TOPIC=

# Push subscription gắn OIDC token; điền audience + service account để webhook
# xác thực request. Để trống = bỏ qua xác thực (chỉ dùng khi phát triển local).
# Public URL của webhook: <PUBLIC_BASE_URL>/api/mail/v1/notifications
MAIL_PUBSUB_AUDIENCE=
MAIL_PUBSUB_SERVICE_ACCOUNT=

# Lọc watch theo label Gmail (mặc định chỉ INBOX).
MAIL_WATCH_LABEL_IDS=INBOX
# Watch hết hạn sau tối đa 7 ngày nên phải gia hạn định kỳ.
MAIL_WATCH_RENEW_INTERVAL=12h
MAIL_WATCH_RENEW_THRESHOLD=24h

# --- Pull mode (tuỳ chọn) -------------------------------------------------
# Set MAIL_PULL_SUBSCRIPTION để mail-provider TỰ PULL notice thay vì chờ Pub/Sub
# push. Cách này chạy local được mà KHÔNG cần tunnel/public URL, nhưng cần
# credential GCP (ADC) có roles/pubsub.subscriber trên subscription.
# Định dạng: projects/<project-id>/subscriptions/<subscription-id>
MAIL_PULL_SUBSCRIPTION=
MAIL_PULL_MAX_MESSAGES=10
MAIL_PULL_TIMEOUT=2m
MAIL_PULL_RETRY_DELAY=5s
# Log "pull đang chạy nhưng chưa có notice" mỗi khoảng này để biết worker còn sống.
# Đặt 0s để tắt heartbeat.
MAIL_PULL_HEARTBEAT=5m

# File key service account. Khi chạy Docker: mount file vào /secrets rồi đặt
# đường dẫn trong container. Khi chạy `make run-mail-provider`: trỏ thẳng file trên máy.
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json

# Workspace nhận task: hiện luôn hỏi workspace service và lấy workspace ĐẦU TIÊN
# của user (đã lọc archived, xếp theo position). Chưa có biến override.
MAIL_DEFAULT_PRIORITY=medium
MAIL_QUEUE_SIZE=256
MAIL_WORKER_COUNT=2
GMAIL_MAX_BODY_BYTES=32768

# --- DeepSeek -------------------------------------------------------------
# Dùng để phân tích email thành JSON công việc.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Cloudflare Tunnel ----------------------------------------------------
# Tunnel token: Cloudflare Zero Trust > Networks > Tunnels > chọn tunnel >
# "Install connector" (Docker) -> lấy chuỗi sau `--token`.
#
# Public hostname của tunnel phải trỏ tới service `http://frontend:80`
# (không phải :8081/:8082/:8083) — đúng MỘT origin duy nhất, vì nginx của
# frontend tự forward /api/* sang các service Go.
#
# Bật connector. Có 2 cách:
#   - make up-tunnel                              (chỉ lần chạy đó)
#   - bỏ comment `COMPOSE_PROFILES=tunnel` dưới  (mọi lệnh compose/`make up`)
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_VERSION=latest

# Port host bind cho entrypoint. Chỉ bind 127.0.0.1 nên không lộ trực tiếp.
FRONTEND_PORT=3000

# Cho cloudflared chạy ngay trong `docker compose up` / `make up` mặc định.
# Đây là biến của chính Compose (không phải của cloudflared).
# COMPOSE_PROFILES=tunnel

# --- Public origin --------------------------------------------------------
# Origin công khai DUY NHẤT của hệ thống. Compose suy ra GOOGLE_REDIRECT_URL và
# FRONTEND_BASE_URL từ biến này.
#   - Chạy local:      http://localhost:3000
#   - Sau Cloudflare:  https://<hostname>
#     (nhớ thêm redirect URI vào Google Cloud Console:
#      <PUBLIC_BASE_URL>/api/identity/v1/auth/google/callback)
# Đổi sang https thì đặt luôn COOKIE_SECURE=true.
PUBLIC_BASE_URL=http://localhost:3000

