# Copy sang `.env` trong cùng thư mục này rồi điền giá trị thật:
#   cp deployments/docker/.env.example deployments/docker/.env
#
# docker compose tự đọc file `.env` cạnh docker-compose.yml.

# --- Google OAuth ---------------------------------------------------------
# Tạo OAuth 2.0 Client ID (loại "Web application") tại
# https://console.cloud.google.com/apis/credentials
#
# Authorized redirect URI phải trùng khít GOOGLE_REDIRECT_URL bên dưới.
# Dùng origin của frontend (không phải :8081) để nginx/vite proxy tiếp sang
# gateway identity — nhờ vậy state OAuth vẫn cùng origin với SPA.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/identity/v1/auth/google/callback

# Origin của SPA; backend redirect về đây sau khi đăng nhập xong.
FRONTEND_BASE_URL=http://localhost:3000

# --- Session --------------------------------------------------------------
# Khoá ký JWT (HS256) và state OAuth. Bắt buộc, tối thiểu 16 ký tự.
# Sinh khoá: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL=720h
# Bật khi chạy sau HTTPS (cookie/redirect an toàn hơn).
COOKIE_SECURE=false
